<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <Configurations>Debug;Release;Issues</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*"/>
        <PackageReference Include="xunit" Version="2.*"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <ValheimDir>$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
        <BepInExDir>$(HOME)/.config/r2modmanPlus-local/Valheim/profiles</BepInExDir>
        <!-- Mirrors the main csproj so a solution-wide `-c Issues` build resolves BepInEx
             from the same profile the plugin is being built against. -->
        <R2ModmanProfile Condition="'$(Configuration)' == 'Issues'">vv-issues</R2ModmanProfile>
        <R2ModmanProfile Condition="'$(R2ModmanProfile)' == ''">valheim-modding</R2ModmanProfile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ValheimVillages\ValheimVillages.csproj"/>
    </ItemGroup>

    <!-- Unity assemblies needed at runtime for algorithm tests using Vector3 -->
    <ItemGroup>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ValheimDir)/valheim_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <!--
        BepInEx is needed at RUNTIME even though no test references it. Any production method
        the tests reach that so much as mentions Plugin.Log has a type reference to BepInEx's
        ManualLogSource, and the JIT resolves that when it PREPARES the method — whether or not
        the logging branch is taken. Adding RegionGraph.ValidateInternalConsistency (which logs
        an error on an inconsistent graph) turned 12 passing tests into
        FileNotFoundException: 'BepInEx, Version=5.4.23.5' raised from SetGraph, with no test
        having changed. UnityEngine is the facade assembly BepInEx.Logging itself needs.
    -->
    <ItemGroup>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExDir)/$(R2ModmanProfile)/BepInEx/core/BepInEx.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(ValheimDir)/valheim_Data/Managed/UnityEngine.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
</Project>
